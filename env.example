# FaunaScope-Edge Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to .env and fill in your actual values
# The .env file is git-ignored to protect your sensitive information
# 
# Usage: cp env.example .env
# -----------------------------------------------------------------------------

# =============================================================================
# Hardware Configuration
# =============================================================================
# Video source - camera index (0, 1, 2...) or path to video file
VIDEO_SOURCE=0

# Camera resolution and framerate
# Run 'v4l2-ctl -d /dev/videoX --list-formats-ext' to see supported values
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=30

# =============================================================================
# Device Information
# =============================================================================
DEVICE_ID=my_camera_001
DEVICE_LATITUDE=37.7749
DEVICE_LONGITUDE=-122.4194
# Timezone in IANA format (e.g., "America/Chicago", "America/New_York", "Europe/London")
# Find your timezone at: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
DEVICE_TIMEZONE=America/Chicago

# =============================================================================
# Data Uploader Configuration
# =============================================================================
# Enable or disable data uploader (true/false)
# Set to false for testing/development to keep files local
UPLOADER_ENABLED=false

# =============================================================================
# Server Configuration
# =============================================================================
# The FaunaScope server that receives the events
SERVER_URL=https://faunascope.txst.edu
# This device's upload token, issued by the server's administrator with `flask device add <DEVICE_ID>`. Keep it secret: it is the device's only credential.
DEVICE_TOKEN=your-device-token
